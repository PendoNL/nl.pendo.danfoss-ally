{
  "title": {
    "en": "Set mode"
  },
  "titleFormatted": {
    "en": "Set mode to [[mode]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=thermostat|icon-thermostat|icon-thermostat-basic"
    },
    {
      "type": "dropdown",
      "name": "mode",
      "title": {
        "en": "Mode"
      },
      "values": [
        { "id": "at_home", "label": { "en": "At home" } },
        { "id": "leaving_home", "label": { "en": "Leaving home" } },
        { "id": "holiday", "label": { "en": "Holiday (Away)" } },
        { "id": "holiday_sat", "label": { "en": "Holiday (Home)" } },
        { "id": "pause", "label": { "en": "Pause" } },
        { "id": "manual", "label": { "en": "Manual" } }
      ]
    }
  ]
}
